# --- 后端 (server.ts) ---------------------------------
# 生产环境下，server.ts 代理 /api/chat 到各家大模型 API。
# 把你的大模型 Key 放在这里，或直接在环境里设值，不要提交真实 key。

GEMINI_API_KEY="填写你的 Google Gemini Key"

# 可选：设置后，所有 /api/* 请求都要求 Authorization: Bearer ACCESS_TOKEN。
# 设 HOST=0.0.0.0 可改变监听网卡（默认 127.0.0.1）。
ACCESS_TOKEN="随机字符串，比如 uuidgen 生成的"
HOST="127.0.0.1"
PORT="3000"

# --- 前端 (vite) -------------------------------------
# 开发环境用的 Vite 配置，一般留空。
# VITE_API_BASE="/api"
